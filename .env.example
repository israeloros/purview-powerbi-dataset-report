# Use either the full Atlas/Data Map endpoint or the Purview account name.
PURVIEW_ENDPOINT=https://your-account.purview.azure.com
# PURVIEW_ACCOUNT_NAME=your-account

# Service principal authentication. PURVIEW_* names take precedence over AZURE_*.
PURVIEW_TENANT_ID=00000000-0000-0000-0000-000000000000
PURVIEW_CLIENT_ID=00000000-0000-0000-0000-000000000000
PURVIEW_CLIENT_SECRET=replace-with-a-secret

# Equivalent standard Azure Identity variables are also supported:
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=replace-with-a-secret

# Set to any non-empty value to allow the interactive browser credential in
# the DefaultAzureCredential chain.
# PURVIEW_ALLOW_INTERACTIVE_BROWSER=true
